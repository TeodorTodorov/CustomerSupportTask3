# Never commit a real value. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KLETT_API_KEY=replace-with-a-random-secret-at-least-24-characters
# Set only when the server is private behind a TLS-terminating reverse proxy.
KLETT_ALLOW_REMOTE_BIND=false
# Comma-separated allowed Host headers. Required for remote bind; no wildcard.
KLETT_ALLOWED_HOSTS=localhost,127.0.0.1
